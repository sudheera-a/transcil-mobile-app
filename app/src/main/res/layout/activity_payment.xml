<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_surface">

        <LinearLayout
            android:id="@+id/navyHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_header"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/back_icon_size"
                android:layout_height="@dimen/back_icon_size"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_navy" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/sora_family"
                android:text="@string/payment_review_title"
                android:textColor="@color/text_on_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/manrope_family"
                android:text="@string/payment_review_subtitle"
                android:textColor="@color/text_on_navy_soft"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/navyHeader">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- REVIEW -->
                <LinearLayout
                    android:id="@+id/panelReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_hero_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sora_family"
                            android:text="@string/payment_breakdown_title"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_rent"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvRent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="₹4,700" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_onboarding"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvOnboarding"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_deposit"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDeposit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_guideline_check" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_deposit_note"
                                android:textColor="@color/brand_primary_dark"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/kyc_step_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/sora_family"
                                android:text="@string/payment_total_today"
                                android:textColor="@color/brand_navy"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/sora_family"
                                android:textColor="@color/brand_navy"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:background="@drawable/bg_home_hero_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_phonepe_tile">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/sora_family"
                                android:text="₹"
                                android:textColor="@color/text_on_navy"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/sora_family"
                            android:text="@string/payment_method_phonepe"
                            android:textColor="@color/brand_navy"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_family"
                            android:text="@string/payment_change_method"
                            android:textColor="@color/brand_primary_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnPay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:textColor="@color/text_on_brand"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Pay ₹7,200" />
                </LinearLayout>

                <!-- AUTOPAY -->
                <LinearLayout
                    android:id="@+id/panelAutopay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_home_hero_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_debit_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvAutopayMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_frequency"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_frequency_monthly"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_first_debit"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_family"
                                android:text="@string/payment_first_debit_value"
                                android:textColor="@color/brand_navy"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/manrope_family"
                        android:text="@string/payment_autopay_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnAuthorise"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:text="@string/payment_authorise"
                        android:textColor="@color/text_on_brand"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPayManual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md"
                        android:text="@string/payment_manual"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PENDING -->
                <LinearLayout
                    android:id="@+id/panelPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_family"
                        android:text="@string/payment_pending_title"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:text="@string/payment_pending_body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:fontFamily="@font/manrope_family"
                        android:text="@string/payment_reference"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/btnCheckStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:text="@string/payment_check_status"
                        android:textColor="@color/text_on_brand"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFailDemo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md"
                        android:text="@string/payment_simulate_fail"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/btnBackHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md"
                        android:text="@string/payment_back_dashboard"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SUCCESS -->
                <LinearLayout
                    android:id="@+id/panelSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/sora_family"
                        android:text="@string/payment_success_title"
                        android:textColor="@color/brand_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:text="@string/payment_success_body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/btnStartRiding"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:text="@string/payment_start_riding"
                        android:textColor="@color/text_on_brand"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnMethods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:padding="@dimen/spacing_md"
                        android:text="@string/payment_manage_methods"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- FAILURE -->
                <LinearLayout
                    android:id="@+id/panelFailure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero_card"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_family"
                        android:text="@string/payment_failure_title"
                        android:textColor="@color/error"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/manrope_family"
                        android:text="@string/payment_failure_body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/btnRetry"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:background="@drawable/bg_button_primary"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:text="@string/payment_try_again"
                        android:textColor="@color/text_on_brand"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- METHODS -->
                <LinearLayout
                    android:id="@+id/panelMethods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_hero_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sora_family"
                        android:text="@string/payment_methods_title"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:fontFamily="@font/manrope_family"
                        android:text="@string/payment_method_upi_demo"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/manrope_family"
                        android:text="@string/payment_method_bank_demo"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/btnCancelAutopay"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_xl"
                        android:background="@drawable/bg_logout_button"
                        android:fontFamily="@font/sora_family"
                        android:gravity="center"
                        android:text="@string/payment_cancel_autopay"
                        android:textColor="@color/logout_button_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
