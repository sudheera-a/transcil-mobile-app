<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/home_surface">

        <LinearLayout
            android:id="@+id/navyHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_navy_header"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="28dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/back_icon_size"
                android:layout_height="@dimen/back_icon_size"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_on_navy" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/sora_family"
                android:text="@string/selfie_title_redesign"
                android:textColor="@color/text_on_navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/manrope_family"
                android:text="@string/selfie_subtitle_redesign"
                android:textColor="@color/text_on_navy_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/pull_up_overlap"
            android:background="@drawable/bg_pull_up_card"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingHorizontal="18dp"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_lg"
            app:layout_constraintBottom_toTopOf="@id/bottomActions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/navyHeader">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_selfie_navy_frame">

                    <ImageView
                        android:id="@+id/ivSelfiePreview"
                        android:layout_width="96dp"
                        android:layout_height="118dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/selfie_title"
                        android:src="@drawable/bg_selfie_oval_guide" />

                    <TextView
                        android:id="@+id/tvPositionHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/manrope_family"
                        android:gravity="center"
                        android:text="@string/selfie_align_face"
                        android:textColor="@color/text_on_navy_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/captureHints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guideline_check" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_family"
                            android:text="@string/selfie_guideline_lighting_redesign"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_guideline_no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_family"
                            android:text="@string/selfie_guideline_no_accessories"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reviewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/selfie_captured_icon_size"
                        android:layout_height="@dimen/selfie_captured_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle" />

                    <TextView
                        android:id="@+id/tvPhotoCaptured"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/sora_family"
                        android:text="@string/selfie_photo_captured"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_primary"
                android:drawablePadding="@dimen/spacing_sm"
                android:drawableStart="@drawable/ic_camera"
                android:fontFamily="@font/sora_family"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/selfie_take_cta"
                android:textAllCaps="false"
                android:textColor="@color/text_on_brand"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:drawableTint="@color/icon_on_brand" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/sora_family"
                android:text="@string/continue_button"
                android:textAllCaps="false"
                android:textColor="@color/text_on_brand"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@null"
                tools:visibility="gone" />

            <Button
                android:id="@+id/btnRetake"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_button_outline_primary"
                android:drawablePadding="@dimen/spacing_sm"
                android:drawableStart="@drawable/ic_camera"
                android:fontFamily="@font/sora_family"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:text="@string/selfie_retake"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:drawableTint="@color/text_primary"
                tools:visibility="gone" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
